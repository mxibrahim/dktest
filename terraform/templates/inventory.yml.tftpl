# Generated by Terraform - do not edit by hand.
# Hosts are addressed by instance ID; SSH is tunnelled through SSM Session
# Manager (AWS-StartSSHSession), so no node needs a public IP or open port.
all:
  vars:
    ansible_user: ubuntu
    ansible_ssh_private_key_file: ${ssh_private_key_path}
    ansible_ssh_common_args: >-
      -o ProxyCommand="aws ssm start-session --region ${region}
      --target %h --document-name AWS-StartSSHSession --parameters portNumber=%p"
    es_cluster_name: ${cluster_name}
  children:
    elasticsearch:
      hosts:
%{ for n in nodes ~}
        ${n.name}:
          ansible_host: ${n.instance_id}
          private_ip: ${n.private_ip}
          private_dns: ${n.private_dns}
          instance_id: ${n.instance_id}
%{ endfor ~}
